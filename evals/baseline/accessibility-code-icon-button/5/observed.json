        "raisedBy": [
          "accessibility"
        ],
        "recommendation": "Add an `alt` naming the owner (e.g. `alt={`${ownerName}'s avatar`}` — which needs the owner's name as a prop), or `alt=\"\"` if the owner is named in visible text elsewhere. Without `alt`, a screen reader announces the image file name or URL from `avatarUrl` instead of who owns the document. WCAG 1.1.1 Non-text Content.",
        "reported": true,
        "role": "accessibility",
        "severity": "medium",
