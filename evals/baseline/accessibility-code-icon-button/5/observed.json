        "evidence": "<div className=\"icon-button\" onClick={onDelete}>\n  <TrashIcon />\n",
        "history": [
          {
            "by": "accessibility",
            "note": null,
            "ref": null,
            "status": "open",
            "to": null
          }
        ],
        "id": "R-accessibility-2",
        "line": 32,
        "location": "src/components/Toolbar.tsx:13-14",
        "raisedBy": [
          "accessibility"
        ],
        "recommendation": "Give the control a text name, for example `aria-label=\"Delete document\"` on the button (or visually hidden text inside it). Its only content is `TrashIcon`, whose `<svg>` is `aria-hidden=\"true\"` (src/components/icons.tsx:3), so the control has no text at all: a screen reader user reaching it hears nothing, or just \"button\" once it becomes a button, and cannot tell it deletes the document. WCAG 1.1.1 Non-text Content, 4.1.2 Name, Role, Value.",
        "reported": true,
        "role": "accessibility",
        "severity": "high",
        "status": "open",
        "step": "code.review",
        "title": "Icon-only delete control has no accessible name"
      },
